# Timeweb App Platform variables for Dockerfile single-container deployment
# Do not commit real secrets. Set production values in the Timeweb UI.

BUILD_TARGET=production
NODE_ENV=production
PORT=8080

APP_URL=https://tsygankovmain-chatsoglasovanieb24-c9c9.twc1.net
VIRTUAL_HOST=https://tsygankovmain-chatsoglasovanieb24-c9c9.twc1.net
NUXT_PUBLIC_APP_URL=https://tsygankovmain-chatsoglasovanieb24-c9c9.twc1.net
NUXT_PUBLIC_API_URL=

# Marketplace/simple OAuth install flow does not require CLIENT_ID/CLIENT_SECRET.
SCOPE=im,imbot,entity,disk,placement,user_basic

# Generate in Timeweb with: openssl rand -hex 32
JWT_SECRET=GENERATE_NEW_SECRET_IN_TIMEWEB
JWT_ALGORITHM=HS256

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
