# ─── Bitrix24 Application credentials ───────────────────────────────────────
# Found in Bitrix24 Developer Area → Your app → OAuth 2.0
CLIENT_ID=local.xxxxxxxxxxxxxxxx
CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Any random long string (openssl rand -hex 32)
JWT_SECRET=<openssl rand -hex 32>
JWT_ALGORITHM=HS256

# ─── App domain ──────────────────────────────────────────────────────────────
# Full URL of your FRONTEND service (including https://)
# Must match exactly what is set in the Bitrix24 app "Handler URL"
# Example: https://chat-app.twc1.net
VIRTUAL_HOST=https://your-frontend-domain.twc1.net

# ─── Build mode ──────────────────────────────────────────────────────────────
# Must be "production" to disable Django DEBUG
BUILD_TARGET=production

# ─── Server port (optional) ──────────────────────────────────────────────────
# Timeweb injects PORT automatically; you can leave this out.
# Default: 8000
# PORT=8000
