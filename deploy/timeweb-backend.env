# Legacy split-backend deployment variables. Prefer deploy/timeweb.env for single-container Timeweb deploy.
BUILD_TARGET=production
VIRTUAL_HOST=https://your-frontend-domain.twc1.net
JWT_SECRET=GENERATE_NEW_SECRET_IN_TIMEWEB
JWT_ALGORITHM=HS256

# Optional for local/full OAuth flows only. Marketplace simple install does not require these.
# CLIENT_ID=
# CLIENT_SECRET=
