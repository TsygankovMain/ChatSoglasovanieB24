# Timeweb App Platform, Dockerfile single-container deployment
BUILD_TARGET=production
NODE_ENV=production

# Public HTTPS URL of this Timeweb application, without trailing slash.
VIRTUAL_HOST=https://your-app-domain.twc1.net
NUXT_PUBLIC_APP_URL=https://your-app-domain.twc1.net

# Empty value means same-origin /api via nginx.
NUXT_PUBLIC_API_URL=

# Bitrix24 local application credentials.
CLIENT_ID=local.xxxxxxxxxxxxxxxx
CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_ALGORITHM=HS256

# Optional runtime tuning.
# PORT=8080
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
