# Timeweb App Platform, Dockerfile single-container deployment
BUILD_TARGET=production
NODE_ENV=production

# Public HTTPS URL of this Timeweb application, without trailing slash.
VIRTUAL_HOST=https://your-app-domain.twc1.net
NUXT_PUBLIC_APP_URL=https://your-app-domain.twc1.net

# Empty value means same-origin /api via nginx.
NUXT_PUBLIC_API_URL=

# Marketplace/simple OAuth install does not require CLIENT_ID/CLIENT_SECRET.
# Leave them unset unless you explicitly use full OAuth/token refresh.
# CLIENT_ID=
# CLIENT_SECRET=

# Generate with: openssl rand -hex 32
JWT_SECRET=GENERATE_NEW_SECRET_IN_TIMEWEB
JWT_ALGORITHM=HS256

# Optional runtime tuning.
# PORT=8080
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
