# ─── Backend API URL ─────────────────────────────────────────────────────────
# Full public URL of your BACKEND service (including https://)
# The browser calls this URL directly — it must be publicly accessible.
# Example: https://chat-app-api.twc1.net
NUXT_PUBLIC_API_URL=https://your-backend-domain.twc1.net

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Server port (optional) ──────────────────────────────────────────────────
# Timeweb injects PORT automatically; you can leave this out.
# Default: 3000
# PORT=3000
