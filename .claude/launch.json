{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ChatApprove - Frontend + Python (full stack)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "docker-compose.dev.yml",
        "--profile",
        "frontend",
        "--profile",
        "python",
        "--profile",
        "cloudpub",
        "up",
        "--build"
      ],
      "port": 3001
    },
    {
      "name": "ChatApprove - Frontend only",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "docker-compose.dev.yml",
        "--profile",
        "frontend",
        "--profile",
        "cloudpub",
        "up",
        "--build"
      ],
      "port": 3001
    },
    {
      "name": "ChatApprove - Python API only",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "docker-compose.dev.yml",
        "--profile",
        "python",
        "up",
        "--build"
      ],
      "port": 8002
    }
  ]
}
